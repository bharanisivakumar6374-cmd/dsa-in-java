import java.util.ArrayList;
public class hello{
    public static int count=0;
    public static int  backtrack(int arr[],int target,int sum,ArrayList<Integer>l){
    
        if(sum==target){
            count++;
            System.out.println(l);
        return 0;}
        

        if(sum>target) return 0;
        for(int i=0;i<arr.length;i++){
            sum+=arr[i];
            l.add(arr[i]);
            backtrack(arr,target,sum,l);
            l.remove(l.size()-1);
            sum-=arr[i];
        }
    return count;
    }
public static void main(String[] args) {
    ArrayList<Integer>l=new ArrayList<>();
int arr[]={1,2,3};
int target=4;
int sum=0;
System.out.print(backtrack(arr,target,sum,l));

}
}


