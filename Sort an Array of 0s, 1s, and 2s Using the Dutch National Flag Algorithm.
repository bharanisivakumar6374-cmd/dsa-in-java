import java.util.Arrays;
import java.util.Scanner;
public class Main
{
	public static void main(String[] args) {
		Scanner hp=new Scanner(System.in);
		int n=hp.nextInt();
		int num[]=new int[n];
		for(int i=0;i<n;i++) num[i]=hp.nextInt();
		int m=0,l=0, r=n-1;
		while(m<=r){
		    if(num[m]==0){
		        int temp=num[l];
		        num[l]=num[m];
		        num[m]=temp;
		        l++;
		        m++;
		    }else if(num[m]==1){
		        m++;
		    }else if(num[m]==2){
		        int temp=num[m];
		        num[m]=num[r];
		        num[r]=temp;
		        r--;
		    }
		}
		System.out.println(Arrays.toString(num));
	}
}
