import java.util.Arrays;
import java.util.Scanner;
public class Main
{
	public static void main(String[] args) {
		Scanner hp=new Scanner(System.in);
		int n=hp.nextInt();
		int arr[]=new int[n];
		int result[]=new int[n];
		for(int i=0;i<n;i++){
		    arr[i]=hp.nextInt();
		}
		int k=0;
		int m=1;
		for(int i=0;i<n;i++){
		    if(arr[i]!=0){
		        result[k]=arr[i];
		        k++;
		    }else if(arr[i]==0){
		        result[arr.length-m]=arr[i];
		        m++;
		    }
		    }
		   
		        System.out.println(Arrays.toString(result));
		   
	}
} description
