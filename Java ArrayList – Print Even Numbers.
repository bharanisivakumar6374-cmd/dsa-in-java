import java.util.ArrayList;
import java.util.Scanner;
public class Main
{
	public static void main(String[] args) {
     Scanner hp=new Scanner(System.in);
     ArrayList<Integer> e=new ArrayList<>();
     int n=hp.nextInt();
     for(int i=0;i<n;i++){
         e.add(hp.nextInt());
     }
     for(int y: e){
         if(y%2==0){
             System.out.println(y);
         }
     }
	}
}
